    status = conectar_banco_dados("192.168.1.10")
    print(status)
except ConnectionRefusedError:
    print("Tratamento de contingência ativado.")


#3.3 Gerenciador de Contexto Customizado via Protocolo Dunder (__enter__ e __exit__)

#Construção de classes capazes de gerenciar estados complexos, como transações atômicas de banco de dados ou travas de concorrência.

class TransacaoSimulada:
    def __init__(self, identificador: str):
        self.identificador = identificador
        self.em_aberto = False

    def __enter__(self):
        """Prepara o recurso e inicia o bloco."""
        self.em_aberto = True
        print(f"\n[TRANS] Início da transação '{self.identificador}'. Lock adquirido.")
        return self

    def __exit__(self, exc_type, exc_val, exc_tb):
        """
        Finaliza a transação. 
        Se exc_type não for None, ocorreu um erro no bloco 'with'.
        """
        self.em_aberto = False
        if exc_type is not None:
            print(f"[TRANS] ROLLBACK executado para '{self.identificador}'. Erro capturado: {exc_val}")
            # Retornar True suprime a exceção; retornar False permite que ela suba na pilha
            return False
        
        print(f"[TRANS] COMMIT realizado com sucesso para '{self.identificador}'.")
        return True

# Cenário 1: Sucesso
with TransacaoSimulada("TX-001") as tx:
    print("  -> Atualizando registros da tabela 'usuarios'...")

# Cenário 2: Falha com Rollback
try:
    with TransacaoSimulada("TX-002") as tx:
        print("  -> Gravando dados de pagamento...")
        raise ValueError("Chave de idempotência duplicada!")
except ValueError:
    print("[APP] Fluxo principal lidando com o erro após o rollback da transação.")


# 3.4 Programação Assíncrona de Alta Concorrência (asyncio)
# O paradigma assíncrono resolve problemas limitados por Entrada/Saída (I/O-Bound) através de um laço de eventos (Event Loop), 
# permitindo que um único thread processe milhares de requisições concorrentes sem a sobrecarga de context-switch de threads do sistema operacional.

import asyncio
from typing import Dict

async def fetch_dados_sensor(sensor_id: str, tempo_resposta: float) -> Dict[str, Any]:
    """Simula consulta de rede a um microcontrolador IoT."""
    print(f"Iniciando requisição ao sensor {sensor_id}...")
    await asyncio.sleep(tempo_resposta)  # Pausa não bloqueante
    print(f"Dados recebidos do sensor {sensor_id}!")
    return {"sensor": sensor_id, "status": "ONLINE", "leitura": 24.8}

async def pipeline_central():
    """Executa chamadas concorrentes usando asyncio.gather."""
    print("--- Disparando leituras concorrentes via Event Loop ---")
    
    tarefas = [
        fetch_dados_sensor("TEMP_01", 1.2),
        fetch_dados_sensor("PRESS_02", 0.8),
        fetch_dados_sensor("FLOW_03", 0.5)
    ]
    
    # As três requisições correm em paralelo no Event Loop
    resultados = await asyncio.gather(*tarefas)
    
    print("\n--- Resultados Consolidados ---")
    for res in resultados:
        print(res)

