#3.5 Métodos Mágicos e Sobrecarga de Operadores (Data Model)
#O Python permite que classes personalizadas se comportem como tipos nativos através do seu protocolo de Dunder Methods (Double Underscores).

class VetorDimensional:
    """Implementa operações vetoriais sobrecarregando operadores matemáticos."""
    
    def __init__(self, x: float, y: float):
        self.x = x
        self.y = y

    def __repr__(self) -> str:
        """Representação formal de desenvolvimento."""
        return f"VetorDimensional(x={self.x}, y={self.y})"

    def __add__(self, outro: 'VetorDimensional') -> 'VetorDimensional':
        """Sobrecarga do operador de adição (+)."""
        if not isinstance(outro, VetorDimensional):
            return NotImplemented
        return VetorDimensional(self.x + outro.x, self.y + outro.y)

    def __mul__(self, escalar: float) -> 'VetorDimensional':
        """Sobrecarga da multiplicação por escalar (*)."""
        if not isinstance(escalar, (int, float)):
            return NotImplemented
        return VetorDimensional(self.x * escalar, self.y * escalar)

    def __eq__(self, outro: object) -> bool:
        """Sobrecarga do operador de igualdade (==)."""
        if not isinstance(outro, VetorDimensional):
            return False
        return self.x == outro.x and self.y == outro.y

v1 = VetorDimensional(2.0, 3.5)
v2 = VetorDimensional(4.0, 1.5)

# Soma vetorial limpa e expressiva
v3 = v1 + v2
print(v3)          # VetorDimensional(x=6.0, y=5.0)

# Multiplicação por escalar
v4 = v1 * 3
print(v4)          # VetorDimensional(x=6.0, y=10.5)

# Verificação de igualdade
print(v1 == VetorDimensional(2.0, 3.5))  # True
