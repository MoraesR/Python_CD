#2.2 Tratamento Robusto de Exceções (try, except, else, finally)
#Garante resiliência e liberação determinística de recursos em caso de falhas.

def converter_telemetria(dado_bruto: str) -> float:
    try:
        valor = float(dado_bruto)
        resultado = 100.0 / valor
    except ValueError as err:
        print(f"Erro de Parse: Não foi possível converter '{dado_bruto}' -> {err}")
        return 0.0
    except ZeroDivisionError:
        print("Erro Crítico: Divisão por zero detectada na telemetria.")
        return 0.0
    else:
        # Executa apenas se o bloco try teve 100% de sucesso
        print("Cálculo realizado com sucesso.")
        return resultado
    finally:
        # Sempre executa (útil para fechar sockets, cursores ou arquivos)
        print("Finalização da rotina de conversão.")

print(converter_telemetria("25.0"))
print(converter_telemetria("corrompido"))


#2.3 Desempacotamento de Argumentos (*args e **kwargs)
#Permite criar funções flexíveis que aceitam uma quantidade variável de argumentos posicionais e nomeados.

def registrar_evento(nivel: str, *mensagens, **metadados):
    """
    *mensagens agrupa argumentos extras em uma tupla.
    **metadados agrupa argumentos chave-valor extras em um dicionário.
    """
    texto_consolidado = " | ".join(mensagens)
    print(f"[{nivel.upper()}] {texto_consolidado}")
    
    for chave, valor in metadados.items():
        print(f"  -> Contexto: {chave} = {valor}")

