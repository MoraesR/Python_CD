# 3.1 Geradores e Avaliação Preguiçosa (yield)
# Geradores processam fluxos de dados massivos linha por linha na memória RAM (Big Data), 
# consumindo espaço constante $\mathcal{O}(1)$ em vez de carregar tudo em listas $\mathcal{O}(N)$.

from typing import Generator, Tuple

def stream_telemetria_iot(limite_leituras: int) -> Generator[Tuple[int, float], None, None]:
    """Gera leituras sob demanda sem alocar todas na memória."""
    import random
    contador = 1
    while contador <= limite_leituras:
        leitura_simulada = round(20.0 + random.uniform(-1.5, 3.5), 2)
        yield (contador, leitura_simulada)  # Suspende e retoma a execução
        contador += 1

# O loop consome um item por vez da memória
fluxo = stream_telemetria_iot(limite_leituras=5)
for seq, valor in fluxo:
    print(f"Buffer processando pacote [{seq}]: {valor}°C")


#3.2 Decoradores Parametrizados e Metaprogramação

# Decoradores modificam ou ampliam o comportamento de funções 
# em tempo de compilação/execução. Um decorador parametrizado 
# envolve três níveis de aninhamento de funções e preservação de metadados com functools.wraps.

import functools
import time
from typing import Callable, Any

def retry_resiliente(max_tentativas: int = 3, intervalo_segundos: float = 1.0):
    """Decorador avançado que implementa política de retentativa automática."""
    def decorator(func: Callable) -> Callable:
        @functools.wraps(func)
        def wrapper(*args, **kwargs) -> Any:
            tentativas_atuais = 0
            while tentativas_atuais < max_tentativas:
                try:
                    return func(*args, **kwargs)
                except Exception as erro:
                    tentativas_atuais += 1
                    print(f"[Falha {tentativas_atuais}/{max_tentativas}] na função '{func.__name__}': {erro}")
                    if tentativas_atuais >= max_tentativas:
                        print(f"Limite excedido. Disparando exceção para montante.")
                        raise
                    time.sleep(intervalo_segundos)
        return wrapper
    return decorator

# Aplicação do decorador parametrizado
@retry_resiliente(max_tentativas=3, intervalo_segundos=0.5)
def conectar_banco_dados(host: str) -> str:
    import random
    if random.choice([True, False]):
        raise ConnectionRefusedError(f"Host '{host}' recusou a conexão TCP.")
    return f"Conectado com sucesso a {host}"

# Teste controlado
