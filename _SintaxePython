#2.4 Programação Orientada a Objetos (POO) com Encapsulamento e Propriedades
#O decorador @property permite controlar o acesso a variáveis protegidas sem quebrar a interface pública da classe.

class ServidorBlade:
    def __init__(self, hostname: str, slots_ram: int):
        self.hostname = hostname               # Atributo público
        self._slots_ram = slots_ram            # Atributo protegido (convenção: _)
        self.__voltagem_atual = 220.0          # Atributo privado (name mangling: __)

    @property
    def slots_ram(self) -> int:
        """Getter para o total de slots."""
        return self._slots_ram

    @slots_ram.setter
    def slots_ram(self, quantidade: int):
        """Setter com validação de regra de negócio."""
        if quantidade <= 0:
            raise ValueError("O servidor precisa ter pelo menos 1 slot de RAM.")
        self._slots_ram = quantidade

    def __str__(self) -> str:
        """Representação amigável em string."""
        return f"ServidorBlade(hostname='{self.hostname}', slots={self._slots_ram})"

blade = ServidorBlade("CMM-SRV-BL01", 16)
print(blade)
blade.slots_ram = 32  # Executa o setter com validação
